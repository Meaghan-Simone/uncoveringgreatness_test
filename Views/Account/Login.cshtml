@model LoginInput
@{ Layout = "_AuthLayout"; ViewData["Title"] = "Sign in"; }
<h2>Welcome back</h2>
<p class="auth-sub">Sign in to your workspace to continue.</p>
<partial name="_ValidationSummary" />
<form asp-action="Login" method="post" autocomplete="on" novalidate>
  <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
  <div class="field">
    <label asp-for="Email">Email address</label>
    <input asp-for="Email" type="email" placeholder="name@company.com" autocomplete="username" autofocus maxlength="200">
    <span asp-validation-for="Email" class="field-error"></span>
  </div>
  <div class="field">
    <div class="auth-label-row"><label asp-for="Password">Password</label><a asp-action="ForgotPassword" class="auth-link">Forgot password?</a></div>
    <div class="pw-wrap">
      <input asp-for="Password" type="password" placeholder="Enter your password" autocomplete="current-password" maxlength="128">
      <button type="button" class="pw-toggle" data-toggle-password="Password" aria-pressed="false" aria-label="Show password">Show</button>
    </div>
    <span asp-validation-for="Password" class="field-error"></span>
  </div>
  <label class="check-row" style="margin-bottom:20px"><input asp-for="RememberMe" type="checkbox"><span class="check-label">Keep me signed in on this device</span></label>
  <button type="submit" class="btn btn-green btn-block"><i class="bi bi-box-arrow-in-right"></i> Sign in</button>
</form>
<p class="auth-foot">Need access? Contact your workspace administrator.</p>
