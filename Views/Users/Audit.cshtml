@model PagedResult<AuditItem>
@{ ViewData["Title"] = "Audit log"; ViewData["Eyebrow"] = "Admin"; string? q = ViewBag.Q; string? act = ViewBag.Action; var actions = (List<string>)ViewBag.Actions; }
<div class="page-head"><div><h2>Audit log</h2><p>A record of sign-ins, permission changes and data changes, newest first.</p></div></div>
<div class="card">
  <form method="get" class="toolbar" style="padding:16px 22px 0">
    <div class="search"><i class="bi bi-search"></i><input type="text" name="q" value="@q" placeholder="Search user, details or IP" maxlength="100"></div>
    <div class="select-wrap"><select name="action" data-autosubmit><option value="">All actions</option>@foreach (var a in actions){<option value="@a" selected="@(act == a)">@a</option>}</select></div>
    <button class="btn btn-outline btn-sm" type="submit">Search</button>
  </form>
  <div class="table-wrap"><table><thead><tr><th>When</th><th>User</th><th>Action</th><th>Record</th><th>Details</th><th>IP</th></tr></thead><tbody>
  @if (!Model.Items.Any())
  {
    <tr><td colspan="6" class="text-muted" style="text-align:center;padding:28px">No audit entries match.</td></tr>
  }
  @foreach (var a in Model.Items)
  {
    <tr><td class="text-muted" style="white-space:nowrap">@UiHelpers.RelativeUtc(a.CreatedUtc)</td><td>@(a.UserName ?? "—")</td>
      <td><span class="badge @(a.Action.Contains("Failed") || a.Action.Contains("Blocked") ? "badge-red" : a.Action.Contains("Deleted") ? "badge-amber" : "badge-gray")">@a.Action</span></td>
      <td class="text-muted">@a.Entity @a.EntityId</td><td class="text-muted" style="max-width:340px">@a.Details</td><td class="mono text-muted" style="font-size:11.5px">@a.IpAddress</td></tr>
  }
  </tbody></table></div>
  <partial name="_Pager" model="(Model.Page, Model.TotalPages, Model.TotalCount, Model.PageSize)" />
</div>
